<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/cream_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.OuvindoABiblia</item>

        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
    </style>

    <style name="Theme.OuvindoABiblia" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/cream_background</item>

        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>

        <!--
          SEM android:statusBarColor / android:navigationBarColor: descontinuados no Android 15
          (API 35) e ignorados com targetSdk = 36. A transparência vem do enableEdgeToEdge()
          na MainActivity. Ver FASE 12 / ISSUE 12.C.
        -->
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>