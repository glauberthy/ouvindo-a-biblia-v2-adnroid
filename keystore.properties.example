# ISSUE PUB-01 — Modelo da config de assinatura de RELEASE.
#
# COMO USAR:
#   1. Copie este arquivo para "keystore.properties" (SEM .example) na RAIZ do projeto.
#   2. Crie a upload keystore com o comando keytool (ver README/instruções da PUB-01).
#   3. Preencha os valores abaixo com os que você definiu ao criar a keystore.
#
# IMPORTANTE: "keystore.properties" e o arquivo .jks NUNCA vão para o git (já cobertos
# pelo .gitignore). Guarde a keystore e as senhas em local seguro — perdê-las impede
# publicar atualizações do app (a menos que use Play App Signing com key reset).

# Caminho do arquivo .jks, RELATIVO À RAIZ do projeto (ou um caminho absoluto).
# Ex.: keystore/upload.jks   (recomendado: guardar FORA do repo e usar caminho absoluto)
storeFile=keystore/upload.jks

# Senha da keystore (store).
storePassword=SUA_SENHA_DA_KEYSTORE

# Alias da chave de upload.
keyAlias=upload

# Senha da chave (pode ser igual à da keystore).
keyPassword=SUA_SENHA_DA_CHAVE
